# ---- API (api/app/main.py reads exactly these names) ----
NS_MOCK=1                                   # 1 = serve contract fixtures when no bundle is loaded (auth is still enforced)
MODEL_REF=local:artifacts/bundles/mock-cic  # or local:artifacts/bundles/cic-v1 | azureml:netsentinel-bundle@latest
# bundles: cic-v1 (2018) | cic-holdout-botnet (live demo) | luflow-v1 | luflow-recal   (build mocks: python scripts/make_mock_bundle.py)
NS_DB_PATH=artifacts/netsentinel.db         # SQLite file; create it with: python scripts/init_db.py
NS_API_KEY=change-me                        # header X-API-Key on POST /v1/flows
NS_ADMIN_KEY=change-me-too                  # header X-Admin-Key on POST /v1/admin/reload-model
NS_SHAP_MAX_PER_BATCH=25                    # SHAP explanations per POST /v1/flows batch (each costs 10-100 ms)
NS_API_URL=http://localhost:8000            # used by dashboard + replay

# ---- Azure ML (M2) ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=

# ---- Azure OpenAI (M5) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

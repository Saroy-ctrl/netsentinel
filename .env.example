# ---- API ----
NS_MOCK=1                                   # 1 = serve contract fixtures (no model needed)
MODEL_REF=local:artifacts/bundles/mock      # or azureml:netsentinel-bundle@latest
# bundles: netsentinel-bundle (2018) | netsentinel-demo-holdout-botnet | netsentinel-luflow | netsentinel-luflow-recal
NS_DB_URL=sqlite:///artifacts/netsentinel.db
NS_INGEST_API_KEY=change-me
NS_ADMIN_KEY=change-me-too
NS_API_URL=http://localhost:8000            # used by dashboard + replay

# ---- Azure ML (M2) ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=

# ---- Azure OpenAI (M5) ----
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=                      # leave blank for local template fallback
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini        # model deployment name
AZURE_OPENAI_API_VERSION=2024-10-21

